# OMP Enhanced - Environment Configuration Example
# Copy this file to .env and fill in your API keys

# BandelBanget (OpenAI-compatible) Configuration
BANDELBANGET_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BANDELBANGET_BASE_URL=https://bandelbanget.xyz/v1
BANDELBANGET_MODEL=deepseek-v4-mod

# Default Provider
DEFAULT_PROVIDER=bandelbanget

# Default Model
DEFAULT_MODEL=deepseek-v4-mod

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Skills Configuration
OMP_SKILLS_PATH=${HOME}/.omp/skills

# System Prompt
OMP_SYSTEM_PROMPT=${HOME}/.omp/prompts/system.md

# Logging
LOG_LEVEL=info
